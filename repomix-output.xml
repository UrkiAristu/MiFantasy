    public function definition(): array
    {
        $inicio = fake()->dateTimeBetween('-2 months', 'now');
        $fin = (clone $inicio)->modify('+6 months');

        return [
            'nombre' => 'Liga '.fake()->city().' '.fake()->year(),
            'fecha_inicio' => $inicio->format('Y-m-d'),
            'fecha_fin' => $fin->format('Y-m-d'),
