<script>
    function togglePassword() {
        const fields = ['password', 'password_confirmation'];
        fields.forEach(id => {
            const input = document.getElementById(id);
            if (input) {
                input.type = input.type === 'password' ? 'text' : 'password';
            }
        });
    }
</script>
